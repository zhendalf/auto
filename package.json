{
  "name": "auto-supervisor",
  "version": "0.3.0",
  "description": "Local-first automation supervisor with scheduling, run history, logs, webhooks, and a dashboard.",
  "homepage": "https://github.com/zhendalf/auto#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhendalf/auto.git"
  },
  "bugs": {
    "url": "https://github.com/zhendalf/auto/issues"
  },
  "module": "index.ts",
  "type": "module",
  "license": "MIT",
  "bin": {
    "auto": "cli/main.ts"
  },
  "exports": {
    ".": "./index.ts"
  },
  "files": [
    "cli",
    "supervisor",
    "ui/index.html",
    "ui/src",
    "ui/tsconfig.json",
    "index.ts",
    "paths.ts",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "LICENSE",
    "tsconfig.package.json"
  ],
  "keywords": [
    "automation",
    "cron",
    "scheduler",
    "bun",
    "webhook",
    "local-first"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "bunx tsc --noEmit",
    "typecheck:ui": "bunx tsc --noEmit -p ui/tsconfig.json",
    "typecheck:package": "bunx tsc --noEmit -p tsconfig.package.json",
    "verify": "bun run typecheck && bun run typecheck:ui && bun test",
    "test:package": "bun test",
    "verify:package": "bun run typecheck:package && bun run typecheck:ui && bun run test:package",
    "prepack": "bun run verify:package"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/prompts": "^2.4.9",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.100.6",
    "bun-plugin-tailwind": "^0.1.2",
    "commander": "^14.0.3",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.2",
    "tailwindcss": "^4.2.4",
    "zod": "^4.4.1"
  }
}
